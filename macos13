name: macOS GUI Denemesi
on: workflow_dispatch # Sadece ben başlattığımda çalışsın

jobs:
  build:
    runs-on: macos-latest
    steps:
      - name: Checkout kodları al
        uses: actions/checkout@v4

      - name: Tmate ile Uzak Bağlantı Kur
        uses: mxschmitt/action-tmate@v3
        with:
          limit-access-to-actor: true # Sadece senin bağlanmana izin verir (güvenli)
